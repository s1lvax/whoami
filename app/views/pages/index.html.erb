<% content_for :title, "Whoami – one link for all of you" %>
<% content_for :description, "One page you own: name, work, links, writing. The link for your email signature, your bios, your slides." %>

<div class="landing">
  <%= render HeroComponent.new(
        signed_in: user_signed_in?,
        page_href: @sample ? public_profile_path(@sample.username) : nil,
        sample: @sample
      ) %>

  <%= render Landing::WalkComponent.new %>
  <%= render Landing::PitchComponent.new %>
  <%= render Landing::FaqComponent.new %>
  <%= render CtaComponent.new %>
  <%= render FooterComponent.new %>
</div>
