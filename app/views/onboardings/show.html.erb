<% steps = %w[name username bio links avatar] %>
<% titles = {
     "name"     => ["Tell us your name", "This is the name at the top of your page."],
     "username" => ["Pick your username", "It becomes your URL. Letters and digits only."],
     "bio"      => ["Say what you do", "One or two lines. You can change it later."],
     "links"    => ["Where should people find you?", "Up to six links. Label and URL."],
     "avatar"   => ["Put a face on it", "PNG, JPG, or WEBP up to 5 MB."]
   } %>
<% index = steps.index(@step) || 4 %>

<div class="gate">
  <div class="gate-top">
    <%= link_to "whoami", root_path, class: "wordmark" %>
    <%= render ThemeToggleComponent.new(variant: :gate) %>
  </div>

  <section class="card card-pad">
    <div class="rail">
      <div class="rail-track" aria-hidden="true">
        <% steps.each_with_index do |_, i| %>
          <span class="<%= 'is-done' if i <= index %>"></span>
        <% end %>
      </div>
      <p class="rail-meta mono">Step <%= index + 1 %> of <%= steps.size %></p>
    </div>

    <h1 class="display"><%= titles[@step]&.first || titles["avatar"].first %></h1>
    <p class="intro"><%= titles[@step]&.last || titles["avatar"].last %></p>

    <% case @step
       when "name" %>
      <%= render Onboarding::StepNameComponent.new(user: @user) %>
    <% when "username" %>
      <%= render Onboarding::StepUsernameComponent.new(user: @user) %>
    <% when "bio" %>
      <%= render Onboarding::StepBioComponent.new(user: @user) %>
    <% when "links" %>
      <%= render Onboarding::StepLinksComponent.new(user: @user) %>
    <% else %>
      <%= render Onboarding::StepAvatarComponent.new(user: @user) %>
    <% end %>
  </section>
</div>
