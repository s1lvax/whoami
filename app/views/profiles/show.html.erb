<% content_for :body_class, params[:preview] ? "identity is-preview" : "identity" %>
<% content_for :og_type, "profile" %>
<% content_for :title, "#{@user.display_name} · @#{@user.handle}" %>
<% content_for :description, @user.bio.presence || "#{@user.display_name}'s page." %>
<% content_for :canonical, public_profile_url_for(@user) %>

<div class="poster">
  <div class="poster-body">
    <% if current_user&.id == @user.id && !params[:preview] %>
      <p class="page-owner">
        <span>This is your page. Only you see this bar.</span>
        <%= link_to "Edit in dashboard →", dashboard_path %>
      </p>
    <% end %>

    <%= render PublicProfile::HeaderComponent.new(user: @user) %>

    <% cache [@user, @links, :links] do %>
      <%= render PublicProfile::LinksSectionComponent.new(user: @user, links: @links) %>
    <% end %>

    <% cache [@user, @experiences, :experiences] do %>
      <%= render PublicProfile::ExperienceSectionComponent.new(experiences: @experiences) %>
    <% end %>

    <% cache [@user, @posts, @pagy.page, :posts] do %>
      <%= render PublicProfile::LatestPostsSectionComponent.new(
        user: @user,
        posts: @posts,
        pagy: @pagy,
      ) %>
    <% end %>

    <footer class="page-foot poster-foot">
      <%= link_to "whoami", root_path, class: "wordmark" %>
      <span class="page-foot-tools">
        <%= link_to "RSS", user_feed_path_for(@user), rel: "alternate", type: "application/rss+xml" %>
        <%= render ThemeToggleComponent.new(variant: :page) %>
      </span>
    </footer>
  </div>
</div>
