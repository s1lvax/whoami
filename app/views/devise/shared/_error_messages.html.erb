<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-cache="false" role="alert" aria-live="assertive"
       class="notice notice-danger" style="margin-bottom: 1.25rem">
    <strong><%= I18n.t("errors.messages.not_saved",
                      count: resource.errors.count,
                      resource: resource.class.model_name.human.downcase) %></strong>
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
