<div class="gate">
  <div class="gate-top">
    <%= link_to "whoami", root_path, class: "wordmark" %>
    <%= render ThemeToggleComponent.new(variant: :gate) %>
  </div>

  <section class="card card-pad">
    <h1 class="display">Forgot your password?</h1>
    <p class="intro">We'll email you a link to set a new one.</p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= render InputComponent.new(form: f, field: :email, type: :email,
                                    label: "Email", autocomplete: "email", autofocus: true) %>

      <div class="actions">
        <%= render ButtonComponent.new(type: :submit, style: :primary, full_width: true) do %>
          Send reset link
        <% end %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
