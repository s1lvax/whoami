<div class="gate">
  <div class="gate-top">
    <%= link_to "whoami", root_path, class: "wordmark" %>
    <%= render ThemeToggleComponent.new(variant: :gate) %>
  </div>

  <section class="card card-pad">
    <h1 class="display">Welcome back</h1>
    <p class="intro">Log in to edit your page.</p>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <%= render InputComponent.new(form: f, field: :email, type: :email,
                                    label: "Email", autocomplete: "email", autofocus: true) %>

      <%= render InputComponent.new(form: f, field: :password, type: :password,
                                    label: "Password", autocomplete: "current-password") %>

      <% if devise_mapping.rememberable? %>
        <label class="check" style="margin-bottom: 1.25rem">
          <%= f.check_box :remember_me %>
          <span>Remember me</span>
        </label>
      <% end %>

      <div class="actions">
        <%= render ButtonComponent.new(type: :submit, style: :primary, full_width: true) do %>
          Log in
        <% end %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </section>
</div>
