<div class="gate">
  <div class="gate-top">
    <%= link_to "← Dashboard", dashboard_path, class: "btn btn-ghost btn-sm" %>
    <%= render ThemeToggleComponent.new(variant: :gate) %>
  </div>

  <section class="card card-pad">
    <h1 class="display">Account</h1>
    <p class="intro">Email and password. Your page lives in the dashboard.</p>

    <%= form_with model: resource, scope: resource_name, url: registration_path(resource_name),
                  method: :put, data: { turbo: true } do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= render InputComponent.new(form: f, field: :email, type: :email,
                                    label: "Email", autocomplete: "email",
                                    hint: (devise_mapping.confirmable? && resource.pending_reconfirmation? ? "Waiting for confirmation of #{resource.unconfirmed_email}" : nil)) %>

      <%= render InputComponent.new(form: f, field: :password, type: :password,
                                    label: "New password", autocomplete: "new-password",
                                    placeholder: "Leave blank to keep current",
                                    hint: (@minimum_password_length ? "#{@minimum_password_length} characters minimum" : nil)) %>

      <%= render InputComponent.new(form: f, field: :password_confirmation, type: :password,
                                    label: "Confirm new password", autocomplete: "new-password") %>

      <%= render InputComponent.new(form: f, field: :current_password, type: :password,
                                    label: "Current password", autocomplete: "current-password",
                                    placeholder: "Required to save changes") %>

      <div class="actions">
        <%= render ButtonComponent.new(type: :submit, style: :primary, full_width: true) do %>
          Save changes
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="card card-pad">
    <h2 style="font-size: 1.1rem; font-family: var(--font-display); font-weight: 650; letter-spacing: -0.02em">Delete account</h2>
    <p class="intro" style="margin-bottom: 1rem">Removes your page, links, posts, and subscribers. There is no undo.</p>
    <%= button_to "Delete my account", registration_path(resource_name), method: :delete,
          data: { turbo_confirm: "Delete your account and everything on it?" },
          class: "btn btn-danger" %>
  </section>
</div>
