<div class="gate">
  <div class="gate-top">
    <%= link_to "whoami", root_path, class: "wordmark" %>
    <%= render ThemeToggleComponent.new(variant: :gate) %>
  </div>

  <section class="card card-pad">
    <div class="gate-glyph" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="m3 8 9 6 9-6"/></svg>
    </div>
    <h1 class="display">One more step</h1>
    <p class="intro" style="margin-bottom: 0">
      We sent a confirmation link. Click it and new posts will land in your inbox.
    </p>
  </section>
</div>
