<% content_for :body_class, "identity" %>
<% content_for :title, "#{@post.title} · #{@user.display_name}" %>
<% content_for :description, @post.excerpt.presence || @post.title %>
<% content_for :canonical, public_post_url_for(@user, @post) %>

<article class="post-wrap">
  <% cache [@user, @post, :header] do %>
    <% author_name = @user.display_name %>
    <% avatar_url = @user.avatar&.attached? ? rails_representation_path(@user.avatar.variant(resize_to_fill: [96, 96])) : nil %>

    <div class="post-top">
      <%= link_to public_profile_path_for(@user), class: "post-back" do %>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        <span>@<%= @user.handle %></span>
      <% end %>
      <span class="post-top-tools">
        <a href="#subscribe-card" class="btn btn-secondary btn-sm">Subscribe</a>
        <%= link_to "whoami", root_path, class: "wordmark", style: "font-size: 0.9rem" %>
      </span>
    </div>

    <h1 class="post-title"><%= @post.title %></h1>
    <% if @post.excerpt.present? %>
      <p class="post-excerpt"><%= @post.excerpt %></p>
    <% end %>

    <p class="post-meta">
      <%= link_to public_profile_path_for(@user) do %>
        <% if avatar_url %>
          <%= image_tag avatar_url, alt: "", class: "avatar avatar-round", loading: "lazy" %>
        <% end %>
        <%= author_name %>
      <% end %>
      <span><%= (@post.published_at || @post.updated_at).to_date.to_fs(:long) %></span>
      <span><%= @post.views %> <%= "read".pluralize(@post.views) %></span>
    </p>
  <% end %>

  <% cache [@post, :body] do %>
    <div class="post-body">
      <div class="prose">
        <%= @post.body %>
      </div>
    </div>
  <% end %>

  <div class="post-end" aria-hidden="true"><span></span><span></span><span></span></div>

  <%= render PublicProfile::NewsletterSubscriptionComponent.new(user: @user, subscription: @subscription, variant: :card) %>

  <% if @more_posts.any? %>
    <% cache [@user, @more_posts, :more] do %>
      <%= render PublicProfile::MorePostsComponent.new(posts: @more_posts) %>
    <% end %>
  <% end %>

  <footer class="page-foot" style="margin-top: 2.5rem">
    <%= link_to "whoami", root_path, class: "wordmark", style: "font-size: 0.9rem" %>
    <span class="page-foot-tools">
      <%= link_to "RSS", user_feed_path_for(@user), rel: "alternate", type: "application/rss+xml" %>
      <%= render ThemeToggleComponent.new(variant: :page) %>
    </span>
  </footer>
</article>

<%= render PublicProfile::NewsletterSubscriptionComponent.new(user: @user, variant: :bar) %>
