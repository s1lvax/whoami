<section class="ws-editor">
  <%= form_with model: post, url: submit_path, method: submit_method, data: { turbo: true }, class: "ws-editor-form" do |f| %>
    <header class="ws-editor-bar">
      <%= link_to cancel_path, class: "btn btn-ghost btn-sm" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        Back
      <% end %>
      <div class="ws-editor-bar-tools">
        <label class="switch">
          <%= f.check_box :status, { class: "switch-input" }, "published", "draft" %>
          <span class="switch-track" aria-hidden="true"></span>
          <span class="switch-label">Published</span>
        </label>
        <%= f.submit "Save", class: "btn btn-primary btn-sm", data: { disable_with: "Saving…" } %>
      </div>
    </header>

    <% if post.errors.any? %>
      <div class="notice notice-danger ws-editor-errors" role="alert">
        <ul>
          <% post.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
        </ul>
      </div>
    <% end %>

    <%= f.text_field :title, class: "ws-editor-title", placeholder: "Untitled", autofocus: post.new_record?,
                     autocomplete: "off", "aria-label": "Title" %>
    <%= f.text_field :excerpt, class: "ws-editor-excerpt", placeholder: "One line that says what this is (optional)",
                     autocomplete: "off", "aria-label": "Excerpt" %>

    <div class="ws-editor-paper">
      <%= f.rich_text_area :body, placeholder: "Write. Markdown works as you type." %>
    </div>

    <p class="ws-editor-help mono">
      <span><b>#</b> heading</span>
      <span><b>**bold**</b></span>
      <span><b>-</b> list</span>
      <span><b>&gt;</b> quote</span>
      <span><b>```</b> code</span>
      <span>paste a URL over text to link it</span>
    </p>

    <aside class="ws-editor-side" aria-label="Newsletter">
      <% if subscribers_count.positive? %>
        <label class="check">
          <%= f.check_box :send_to_newsletter, disabled: post.newsletter_sent? %>
          <span>Email this to <%= pluralize(subscribers_count, "subscriber") %> when it's published</span>
        </label>
        <% if post.newsletter_sent? %>
          <p class="hint">Already sent to your subscribers.</p>
        <% end %>
      <% else %>
        <p class="ws-editor-side-title">No subscribers yet.</p>
        <p class="hint">Readers can subscribe from any of your posts. Share your page to get some — then you can email new posts from here.</p>
        <p class="ws-editor-share">
          <span data-controller="clipboard" data-clipboard-text-value="<%= public_url %>" class="ws-editor-share">
            <button type="button" class="url-pill" data-action="clipboard#copy" title="Copy link">
              <b><%= public_url.sub(%r{\Ahttps?://}, "").delete_suffix("/") %></b>
            </button>
            <button type="button" class="btn btn-secondary btn-sm" data-action="clipboard#copy">Copy link</button>
          </span>
        </p>
      <% end %>
    </aside>
  <% end %>
</section>
