<%= helpers.turbo_frame_tag frame_id do %>
  <li class="ws-inline-form">
    <%= form_with model: link, url: form_url, data: { turbo: true, controller: "draft", draft_kind_value: "link", draft_url_value: helpers.link_dashboard_draft_path, draft_id_value: (link.id if link.respond_to?(:id)) } do |f| %>
      <div class="ws-grid-12">
        <div class="c5 field <%= "is-invalid" if link.errors[:label].any? %>">
          <%= f.label :label, "Title" %>
          <%= f.text_field :label, placeholder: "GitHub" %>
          <% if link.errors[:label].any? %>
            <p class="error"><%= link.errors[:label].first %></p>
          <% end %>
        </div>

        <div class="c7 field <%= "is-invalid" if link.errors[:url].any? %>">
          <%= f.label :url, "URL" %>
          <%= f.url_field :url, placeholder: "https://example.com", class: "mono" %>
          <% if link.errors[:url].any? %>
            <p class="error"><%= link.errors[:url].first %></p>
          <% end %>
        </div>
      </div>

      <% if link.errors[:base].any? %>
        <p class="error" style="margin-bottom: 0.75rem"><%= link.errors[:base].first %></p>
      <% end %>

      <div class="ws-inline-actions">
        <%= link_to "Cancel",
              cancel_path,
              data: { turbo_frame: (link.persisted? ? "_top" : "new_favorite_link") },
              class: "btn btn-ghost btn-sm" %>
        <%= f.submit submit_label, class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </li>
<% end %>
