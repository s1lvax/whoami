<section class="ws-editor ws-post-show">
  <header class="ws-editor-bar">
    <%= link_to helpers.dashboard_path(anchor: "writing"), class: "btn btn-ghost btn-sm" do %>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      Back
    <% end %>
    <div class="ws-editor-bar-tools">
      <% if post.published? %>
        <%= link_to "View live", helpers.public_post_path_for(post.user, post), class: "btn btn-ghost btn-sm", target: "_blank", rel: "noopener" %>
      <% end %>
      <%= link_to "Delete", delete_path,
            data: { turbo_method: :delete, turbo_confirm: "Delete this post?" },
            class: "btn btn-danger btn-sm" %>
      <%= link_to "Edit", edit_path, class: "btn btn-primary btn-sm" %>
    </div>
  </header>

  <p class="ws-post-meta-row mono">
    <span class="chip <%= post.published? ? "chip-ok chip-dot" : "" %>"><%= status_text %></span>
    <span><%= date_text %></span>
    <span><%= views_text %></span>
  </p>
  <h1 class="ws-editor-title ws-post-title"><%= post.title %></h1>
  <% if post.excerpt.present? %>
    <p class="ws-editor-excerpt ws-post-excerpt"><%= post.excerpt %></p>
  <% end %>

  <div class="ws-editor-paper post-body">
    <div class="prose">
      <%= post.body %>
    </div>
  </div>
</section>
