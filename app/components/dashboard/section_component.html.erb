<section class="card card-pad" <%= tag.attributes(id: @id) if @id %>>
  <div class="card-head">
    <h2><%= @title %><% if @count %> <span class="count"><%= @count %></span><% end %></h2>
    <% if @action_label && @action_href %>
      <%= link_to @action_label, @action_href, class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>
  <%= content %>
</section>
