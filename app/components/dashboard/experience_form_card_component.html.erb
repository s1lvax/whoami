<%= helpers.turbo_frame_tag frame_id do %>
  <li class="ws-inline-form" style="list-style: none">
    <%= form_with model: experience, url: form_url, data: { turbo: true, controller: "draft", draft_kind_value: "experience", draft_url_value: helpers.experience_dashboard_draft_path, draft_id_value: (experience.id if experience.respond_to?(:id)) } do |f| %>
      <div class="ws-grid-12">
        <div class="c6 field <%= "is-invalid" if experience.errors[:company].any? %>">
          <%= f.label :company %>
          <%= f.text_field :company %>
          <% if experience.errors[:company].any? %><p class="error"><%= experience.errors[:company].first %></p><% end %>
        </div>

        <div class="c6 field <%= "is-invalid" if experience.errors[:role].any? %>">
          <%= f.label :role %>
          <%= f.text_field :role %>
          <% if experience.errors[:role].any? %><p class="error"><%= experience.errors[:role].first %></p><% end %>
        </div>

        <div class="c6 field">
          <%= f.label :location, "Location (optional)" %>
          <%= f.text_field :location %>
        </div>

        <div class="c3 field <%= "is-invalid" if experience.errors[:start_date].any? %>">
          <%= f.label :start_date %>
          <%= f.date_field :start_date %>
          <% if experience.errors[:start_date].any? %><p class="error"><%= experience.errors[:start_date].first %></p><% end %>
        </div>

        <div class="c3 field <%= "is-invalid" if experience.errors[:end_date].any? %>">
          <%= f.label :end_date, "End date (blank = current)" %>
          <%= f.date_field :end_date %>
          <% if experience.errors[:end_date].any? %><p class="error"><%= experience.errors[:end_date].first %></p><% end %>
        </div>

        <div class="field">
          <%= f.label :highlights, "Highlights (one per line)" %>
          <%= f.text_area :highlights, rows: 4, placeholder: "Led migration to multi-tenant architecture\nCut p95 latency by 38%" %>
        </div>

        <div class="field">
          <%= f.label :tech, "Tech (comma separated)" %>
          <%= f.text_field :tech, placeholder: "Ruby, Rails, Sidekiq, Redis, Kubernetes" %>
        </div>
      </div>

      <% if experience.errors[:base].any? %>
        <p class="error" style="margin-bottom: 0.75rem"><%= experience.errors[:base].first %></p>
      <% end %>

      <div class="ws-inline-actions">
        <%= link_to "Cancel",
              cancel_path,
              data: { turbo_frame: (experience.persisted? ? "_top" : "new_experience") },
              class: "btn btn-ghost btn-sm" %>
        <%= f.submit submit_label, class: "btn btn-primary btn-sm" %>
      </div>
    <% end %>
  </li>
<% end %>
