<%= form_with model: user,
              url: update_href,
              method: :patch,
              data: { turbo: true, controller: "avatar-preview draft", draft_kind_value: "profile" },
              html: { multipart: true } do |f| %>

  <div class="ws-profile">
    <div class="ws-avatar-edit">
      <img data-avatar-preview-target="img"
           src="<%= avatar_src.presence || initials_data_uri(display_name, 192) %>"
           alt="<%= display_name %>"
           width="72" height="72"
           class="avatar avatar-tile">

      <%= f.file_field :avatar,
            direct_upload: true,
            accept: "image/png,image/jpeg,image/webp",
            data: { action: "change->avatar-preview#pick" },
            class: "file" %>

      <label class="check">
        <%= f.check_box :remove_avatar, value: "1" %>
        <span>Remove avatar</span>
      </label>

      <% if user.errors[:avatar].any? %>
        <p class="error"><%= user.errors[:avatar].first %></p>
      <% else %>
        <p class="hint">PNG, JPG, or WEBP up to 5&nbsp;MB</p>
      <% end %>
    </div>

    <div class="ws-profile-text">
      <div class="ws-form-grid">
        <%= render InputComponent.new(
              form: f, field: :name, type: :text,
              label: "First name", autocomplete: "given-name",
              input_options: { value: user.name }
            ) %>

        <%= render InputComponent.new(
              form: f, field: :family_name, type: :text,
              label: "Family name", autocomplete: "family-name",
              input_options: { value: user.family_name }
            ) %>
      </div>

      <%= render InputComponent.new(
            form: f, field: :bio, type: :text_area,
            label: "Short bio",
            input_options: {
              rows: 4,
              placeholder: "What do you do? What are you into?",
              value: user.bio
            }
          ) %>

      <div class="ws-form-actions">
        <%= render ButtonComponent.new(type: :submit, style: :primary, full_width: false) do %>
          Save changes
        <% end %>
        <%= link_to "Cancel", cancel_href, data: { turbo_frame: "profile_header" }, class: "btn btn-ghost" %>
      </div>
    </div>
  </div>
<% end %>
