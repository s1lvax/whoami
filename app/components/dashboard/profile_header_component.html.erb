<div class="ws-profile">
  <%= avatar_tag %>

  <div class="ws-profile-text">
    <h3 class="ws-profile-name display"><%= display_name %></h3>
    <p class="ws-profile-handle mono"><%= handle %></p>
    <% if bio.present? %>
      <p class="ws-profile-bio"><%= bio %></p>
    <% end %>
  </div>

  <% if edit_href.present? %>
    <div class="ws-profile-actions">
      <%= link_to "Edit profile", edit_href, data: { turbo_frame: "profile_header" }, class: "btn btn-secondary btn-sm" %>
    </div>
  <% end %>
</div>
