<%= helpers.turbo_frame_tag dom_id_for do %>
  <li class="ws-link">
    <span class="ws-glyph"><%= helpers.link_icon(@link.url) %></span>

    <div class="ws-link-text">
      <p class="ws-link-label"><%= @link.label %></p>
      <p class="ws-link-host mono"><%= helpers.link_host(@link.url) %></p>
    </div>

    <span class="ws-link-clicks num" title="Clicks">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>
      </svg>
      <%= @link.clicks || 0 %>
    </span>

    <div class="ws-link-actions">
      <%= link_to "Edit", edit_path, data: { turbo_frame: dom_id_for }, class: "btn btn-ghost btn-sm" %>
      <%= link_to delete_path,
                  data: { turbo_method: :delete, turbo_confirm: "Delete this link?" },
                  class: "btn btn-ghost btn-icon", "aria-label": "Delete #{@link.label}" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      <% end %>
    </div>
  </li>
<% end %>
