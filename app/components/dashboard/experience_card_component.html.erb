<%= helpers.turbo_frame_tag dom_id_for do %>
  <li class="row ws-row">
    <p class="row-when"><%= date_range %></p>
    <div class="row-body">
      <h3 class="row-title"><%= @experience.role %> · <%= @experience.company %></h3>
      <% if @experience.location.present? %>
        <p class="row-sub"><%= @experience.location %></p>
      <% end %>

      <% if @experience.highlights_list.any? %>
        <ul class="row-notes">
          <% @experience.highlights_list.each do |h| %>
            <li><%= h %></li>
          <% end %>
        </ul>
      <% end %>

      <% if @experience.tech_list.any? %>
        <p class="row-tech">
          <% @experience.tech_list.each do |t| %>
            <span class="chip"><%= t %></span>
          <% end %>
        </p>
      <% end %>
    </div>

    <div class="ws-row-actions">
      <%= link_to "Edit", edit_path, data: { turbo_frame: dom_id_for }, class: "btn btn-ghost btn-sm" %>
      <%= link_to destroy_path,
                  data: { turbo_method: :delete, turbo_confirm: "Delete this experience?" },
                  class: "btn btn-ghost btn-icon", "aria-label": "Delete #{@experience.role} at #{@experience.company}" do %>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      <% end %>
    </div>
  </li>
<% end %>
