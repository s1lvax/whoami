<div data-controller="links">
  <%= form_with model: user,
                url: onboarding_path(step: "links"),
                method: :patch,
                data: { turbo: true } do |f| %>

    <div id="links-list" data-links-target="list" class="gate-link-rows">
      <%= f.fields_for :favorite_links do |ff| %>
        <div class="gate-link-row" data-links-target="item">
          <%= ff.hidden_field :position, value: ff.index || 0 %>

          <%= render InputComponent.new(form: ff, field: :label, type: :text,
                                        label: "Label", placeholder: "GitHub") %>
          <%= render InputComponent.new(form: ff, field: :url, type: :text,
                                        label: "URL", placeholder: "https://github.com/you",
                                        input_options: { class: "mono" }) %>

          <button type="button" data-action="links#remove" class="btn btn-ghost btn-sm">Remove</button>

          <%= ff.hidden_field :_destroy, value: "false", data: { links_target: "destroy" } %>
        </div>
      <% end %>
    </div>

    <template data-links-target="template">
      <div class="gate-link-row" data-links-target="item">
        <input type="hidden" name="user[favorite_links_attributes][__INDEX__][position]" value="0">
        <div class="field">
          <label for="user_favorite_links_attributes___INDEX___label">Label</label>
          <input type="text" name="user[favorite_links_attributes][__INDEX__][label]"
                 id="user_favorite_links_attributes___INDEX___label" class="input" placeholder="GitHub">
        </div>
        <div class="field">
          <label for="user_favorite_links_attributes___INDEX___url">URL</label>
          <input type="text" name="user[favorite_links_attributes][__INDEX__][url]"
                 id="user_favorite_links_attributes___INDEX___url" class="input mono" placeholder="https://github.com/you">
        </div>
        <input type="hidden" name="user[favorite_links_attributes][__INDEX__][_destroy]" value="false">
        <button type="button" data-action="links#remove" class="btn btn-ghost btn-sm">Remove</button>
      </div>
    </template>

    <div class="gate-link-tools">
      <button type="button" data-action="links#add" class="btn btn-secondary btn-sm">+ Add link</button>
      <span>Up to 6 links</span>
    </div>

    <div class="actions">
      <%= render ButtonComponent.new(type: :submit, style: :primary, full_width: true) do %>
        Continue
      <% end %>
      <%= render ButtonComponent.new(type: :submit, style: :secondary, full_width: true, name: "skip") do %>
        Skip for now
      <% end %>
    </div>
  <% end %>
</div>
