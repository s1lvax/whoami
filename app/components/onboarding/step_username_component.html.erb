<%= form_with model: user,
              url: onboarding_path(step: "username"),
              method: :patch,
              data: { turbo: true } do |f| %>

  <div data-controller="username-check">
    <div class="gate-username-head">
      <label class="label" for="user_username">Username</label>
      <turbo-frame id="username_status">
        <% if user.username.present? %>
          <span class="status is-ok" data-available="true">Available ✓ — claimed on sign-up</span>
        <% else %>
          <span class="status">Type a username…</span>
        <% end %>
      </turbo-frame>
    </div>

    <%= render InputComponent.new(
          form: f,
          field: :username,
          type: :text,
          label: nil,
          autocomplete: "off",
          input_options: {
            data: {
              action: "input->username-check#changed",
              username_check_target: "input"
            },
            inputmode: "latin",
            spellcheck: "false",
            class: "mono"
          }
        ) %>

    <p class="url-pill">whoami.tech/<b><%= user.username.presence || "you" %></b></p>
  </div>

  <div class="actions">
    <%= render ButtonComponent.new(type: :submit, style: :primary, full_width: true) do %>
      Continue
    <% end %>
  </div>
<% end %>

<hr class="divider">

<h2>Or import from GitHub</h2>
<%= form_with url: github_import_path, method: :post do %>
  <div class="field">
    <label for="github_login">GitHub username</label>
    <%= text_field_tag :github_login, user.username, class: "input mono", autocomplete: "off" %>
    <p class="hint">Pulls name, bio, avatar, and public links.</p>
  </div>
  <%= submit_tag "Import from GitHub", class: "btn btn-secondary btn-block" %>
<% end %>
