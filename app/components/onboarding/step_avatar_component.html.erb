<div data-controller="avatar-preview">
  <%= form_with model: user,
                url: onboarding_path(step: "avatar"),
                method: :patch,
                html: { multipart: true },
                data: { turbo: true } do |f| %>

    <div class="gate-avatar">
      <div class="avatar avatar-tile" style="overflow: hidden">
        <img data-avatar-preview-target="img"
             src="<%= user.avatar.attached? ? rails_representation_path(user.avatar.variant(resize_to_fill: [192, 192])) : '' %>"
             alt="<%= user.avatar.attached? ? user.display_name : '' %>"
             class="<%= user.avatar.attached? ? '' : 'hidden' %>"
             style="width: 100%; height: 100%; object-fit: cover">
      </div>
      <div>
        <%= f.file_field :avatar,
              direct_upload: true,
              accept: "image/png,image/jpeg,image/webp",
              data: { action: "change->avatar-preview#pick" },
              class: "file" %>
        <% if user.errors[:avatar].any? %>
          <p class="error"><%= user.errors[:avatar].first %></p>
        <% else %>
          <p class="hint">Square works best.</p>
        <% end %>
      </div>
    </div>

    <div class="actions">
      <%= render ButtonComponent.new(type: :submit, style: :primary, full_width: true) do %>
        Continue
      <% end %>
      <%= render ButtonComponent.new(type: :submit, style: :secondary, full_width: true, name: "skip") do %>
        Skip for now
      <% end %>
    </div>
  <% end %>
</div>
