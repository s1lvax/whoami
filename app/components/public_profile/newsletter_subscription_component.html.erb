<% form_url = helpers.new_subscription_path_for(user) %>

<% case variant %>
<% when :bar %>
  <aside class="subscribe-bar" id="subscribe-bar" data-controller="subscribe-bar" data-subscribe-bar-key-value="whoami:subscribe-bar:<%= user.username %>" hidden>
    <div class="subscribe-bar-inner">
      <% if avatar_url %><%= image_tag avatar_url, alt: "", class: "avatar avatar-round subscribe-bar-avatar", loading: "lazy" %><% end %>
      <p class="subscribe-bar-copy">
        <strong>New posts from <%= display_name %>, by email.</strong>
        <% if social_proof %><span><%= social_proof %></span><% end %>
      </p>
      <%= form_with(url: form_url, method: :post, scope: :subscription, class: "subscribe-bar-form") do |f| %>
        <%= hidden_field_tag :variant, "bar", id: nil %>
        <%= f.email_field :subscriber_email, id: field_id, placeholder: "you@example.com", required: true,
                          autocomplete: "email", class: "input", "aria-label": "Email address" %>
        <%= f.submit "Subscribe", class: "btn btn-primary", data: { disable_with: "Sending…" } %>
      <% end %>
      <button type="button" class="subscribe-bar-close" data-action="subscribe-bar#dismiss" aria-label="Not now">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </aside>

<% when :inline %>
  <div class="subscribe-inline" id="subscribe-inline">
    <p class="subscribe-inline-copy">
      <strong>New posts by email.</strong>
      <span><%= social_proof || "Confirm once, unsubscribe any time." %></span>
    </p>
    <%= form_with(url: form_url, method: :post, scope: :subscription, class: "subscribe-inline-form") do |f| %>
      <%= hidden_field_tag :variant, "inline", id: nil %>
      <%= f.email_field :subscriber_email, id: field_id, placeholder: "you@example.com", required: true,
                        autocomplete: "email", class: "input", "aria-label": "Email address" %>
      <%= f.submit "Subscribe", class: "btn btn-primary", data: { disable_with: "Sending…" } %>
    <% end %>
  </div>

<% else %>
  <section class="subscribe-card" id="subscribe-card" aria-labelledby="subscribe-heading" data-subscribe-card>
    <% if avatar_url %>
      <%= image_tag avatar_url, alt: "", class: "avatar avatar-round subscribe-card-avatar", loading: "lazy" %>
    <% end %>
    <div class="subscribe-card-copy">
      <h2 id="subscribe-heading">Get the next one by email</h2>
      <p>
        <% if social_proof %><%= social_proof %><% else %>No feed, no ads — one email per post.<% end %>
      </p>
      <% if subscription&.errors&.any? %>
        <% subscription.errors.full_messages.each do |msg| %>
          <span class="error"><%= msg %></span>
        <% end %>
      <% end %>
    </div>
    <%= form_with(url: form_url, method: :post, scope: :subscription, class: "subscribe-card-form") do |f| %>
      <%= hidden_field_tag :variant, "card", id: nil %>
      <%= f.email_field :subscriber_email, id: field_id, placeholder: "you@example.com", required: true,
                        autocomplete: "email", class: "input", "aria-label": "Email address" %>
      <%= f.submit "Subscribe", class: "btn btn-primary", data: { disable_with: "Sending…" } %>
    <% end %>
  </section>
<% end %>
