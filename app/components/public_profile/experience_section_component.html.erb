<section class="poster-section b-work" aria-labelledby="work-heading">
  <div class="card-head">
    <h2 id="work-heading">Work</h2>
    <span class="count"><%= experiences.size %></span>
  </div>

  <ul class="rows timeline">
    <% experiences.each do |exp| %>
      <li class="row<%= " is-current" if end_date_for(exp).blank? %>" data-experience data-id="<%= exp.respond_to?(:id) ? exp.id : nil %>">
        <p class="row-when"><%= date_range_for(exp) %></p>
        <div class="row-body">
          <h3 class="row-title"><%= role_for(exp) %> · <%= company_for(exp) %></h3>
          <% if location_for(exp).present? %>
            <p class="row-sub"><%= location_for(exp) %></p>
          <% end %>

          <% hl = highlights_for(exp) %>
          <% if hl.any? %>
            <ul class="row-notes">
              <% hl.each do |h| %>
                <li><%= h %></li>
              <% end %>
            </ul>
          <% end %>

          <% techs = tech_for(exp) %>
          <% if techs.any? %>
            <p class="row-tech">
              <% techs.first(5).each do |t| %>
                <span class="chip" data-tech><%= t %></span>
              <% end %>
            </p>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>
</section>
