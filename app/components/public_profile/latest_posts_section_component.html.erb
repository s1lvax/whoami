<section class="poster-section b-writing" aria-labelledby="writing-heading">
  <div class="card-head">
    <h2 id="writing-heading">Writing</h2>
    <span class="count"><%= pagy&.count || posts.size %></span>
  </div>

  <ul class="rows">
    <% posts.each do |post| %>
      <li class="row">
        <p class="row-when"><%= date_text(post) %></p>
        <div class="row-body">
          <h3 class="row-title"><%= link_to post.title, public_post_path_for(post) %></h3>
          <% if (ex = excerpt_text(post)) %>
            <p class="row-excerpt"><%= ex %></p>
          <% end %>
        </div>
      </li>
    <% end %>
  </ul>

  <% if pagy.present? && pagy.last > 1 %>
    <div style="margin-top: 1.25rem">
      <%= render PaginationComponent.new(pagy: pagy) %>
    </div>
  <% end %>

  <%= render PublicProfile::NewsletterSubscriptionComponent.new(user: @user, variant: :inline) %>
</section>
