<section class="more" aria-label="More writing">
  <h2>More writing</h2>
  <% if posts.any? %>
    <ul>
      <% posts.each do |post| %>
        <li>
          <%= link_to public_post_path_for(post) do %>
            <p class="row-title"><%= post.title %></p>
            <p class="row-sub"><%= date_text(post) %> · <%= views_text(post) %></p>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
