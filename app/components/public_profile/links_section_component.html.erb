<section class="poster-links" aria-label="Links">
  <% links.each do |link| %>
    <%= link_to href_for(link), class: "b-link poster-link", title: link.url, data: { id: link.id },
                style: "--brand: #{helpers.link_brand(link.url)}" do %>
      <span class="tile-glyph"><%= helpers.link_icon(link.url) %></span>
      <span class="tile-text">
        <span class="tile-label"><%= link.label %></span>
        <span class="tile-host"><%= host_for(link) %></span>
      </span>
      <svg class="tile-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
    <% end %>
  <% end %>
</section>
