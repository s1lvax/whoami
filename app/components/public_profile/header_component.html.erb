<section class="poster-hero b-id" aria-label="Identity">
  <div class="poster-hero-text">
    <h1 class="page-name"><%= display_name %></h1>
    <p class="page-handle mono"><%= handle %></p>
    <% if user.respond_to?(:bio) && user.bio.present? %>
      <p class="page-bio" data-bio><%= user.bio %></p>
    <% end %>
  </div>
  <% if avatar? %>
    <div class="poster-photo b-avatar">
      <%= image_tag avatar_src(768), fetchpriority: "high", width: 384, height: 384, alt: "" %>
    </div>
  <% end %>
</section>
