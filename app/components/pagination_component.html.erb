<% if pagy && pagy.last > 1 %>
  <nav class="pager" aria-label="Pagination">
    <% if pagy.previous %>
      <%= link_to "← Previous", url_for(request.params.merge(page: pagy.previous)), class: "btn btn-ghost btn-sm" %>
    <% else %>
      <span class="btn btn-ghost btn-sm" aria-disabled="true">← Previous</span>
    <% end %>

    <span class="pager-info mono">page <%= pagy.page %> of <%= pagy.last %></span>

    <% if pagy.next %>
      <%= link_to "Next →", url_for(request.params.merge(page: pagy.next)), class: "btn btn-ghost btn-sm" %>
    <% else %>
      <span class="btn btn-ghost btn-sm" aria-disabled="true">Next →</span>
    <% end %>
  </nav>
<% end %>
